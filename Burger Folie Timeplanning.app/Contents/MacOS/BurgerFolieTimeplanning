#!/bin/sh
APP_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
INDEX="$APP_ROOT/index.html"
PID_FILE="/tmp/burger-folie-timeplanning.pid"
PORT_FILE="/tmp/burger-folie-timeplanning.port"
LOG_FILE="/tmp/burger-folie-timeplanning.log"

open_file_fallback() {
  if command -v open >/dev/null 2>&1; then
    open "$INDEX"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$INDEX"
  else
    printf '%s\n' "$INDEX"
  fi
}

if [ ! -f "$INDEX" ]; then
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'display dialog "Burger Folie Timeplanning could not find index.html next to the app." buttons {"OK"} default button "OK"'
  fi
  exit 1
fi

if command -v python3 >/dev/null 2>&1; then
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
    PORT="$(cat "$PORT_FILE" 2>/dev/null)"
    if [ -n "$PORT" ]; then
      open "http://127.0.0.1:$PORT/index.html"
      exit 0
    fi
  fi

  cd "$APP_ROOT" || exit 1
  PORT=57413
  while [ "$PORT" -le 57425 ]; do
    python3 -m http.server "$PORT" --bind 127.0.0.1 >"$LOG_FILE" 2>&1 &
    SERVER_PID=$!
    sleep 1
    if kill -0 "$SERVER_PID" 2>/dev/null; then
      printf '%s\n' "$SERVER_PID" >"$PID_FILE"
      printf '%s\n' "$PORT" >"$PORT_FILE"
      open "http://127.0.0.1:$PORT/index.html"
      exit 0
    fi
    PORT=$((PORT + 1))
  done
fi

open_file_fallback
